---
// The calendar itself, in the page, under one heading.
import { CAL_LINK } from '../consts';
---

<section class="sec book" id="book">
	<h2 class="sec-title" data-lines>
		<span data-line>Book a</span>
		<span data-line>Discovery Call</span>
	</h2>
	<div class="cal" id="cal" data-link={CAL_LINK}></div>
</section>

<style>
	#book {
		scroll-margin-top: 56px;
	}
	.cal {
		position: relative;
		max-width: 1280px;
		margin: 3.5em auto 0;
		/* Room for the calendar before Cal.com sizes its own frame. */
		min-height: 700px;
	}
	/* Cal.com caps its own width at about 1040px, so on big screens the frame is scaled up
	   as a whole instead, type included. */
	@media (min-width: 1200px) {
		.cal {
			zoom: 1.18;
		}
	}
</style>

<script>
	import { embedCal } from '../scripts/cal';

	// The embed is fetched as the section nears the screen, not on page load.
	function init() {
		const el = document.querySelector<HTMLElement>('#cal');
		if (!el) return;
		const io = new IntersectionObserver(
			(entries) => {
				if (!entries.some((e) => e.isIntersecting)) return;
				io.disconnect();
				embedCal(el, el.dataset.link!);
			},
			{ rootMargin: '800px 0px' },
		);
		io.observe(el);
		document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
	}

	document.addEventListener('astro:page-load', init);
</script>
