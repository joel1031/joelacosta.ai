---
// The calendar itself, in the page. Nothing else: the sections above have made the case.
import { CALENDLY_URL } from '../consts';
---

<section class="sec book" id="book">
	<div class="cal" id="calendly" data-url={CALENDLY_URL}></div>
</section>

<style>
	.cal {
		/* Calendly's loading dots are placed against the nearest positioned box; without this
		   they land half-way down the page, in the pricing section. */
		position: relative;
		max-width: 1040px;
		margin: 0 auto;
		/* Room for the calendar before Calendly sizes its own frame. */
		min-height: 700px;
	}
</style>

<script>
	import { embedCalendly } from '../scripts/calendly';

	// The widget is fetched as the section nears the screen, not on page load.
	function init() {
		const el = document.querySelector<HTMLElement>('#calendly');
		if (!el) return;
		const io = new IntersectionObserver(
			(entries) => {
				if (!entries.some((e) => e.isIntersecting)) return;
				io.disconnect();
				embedCalendly(el, el.dataset.url!);
			},
			{ rootMargin: '800px 0px' },
		);
		io.observe(el);
		document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
	}

	document.addEventListener('astro:page-load', init);
</script>
