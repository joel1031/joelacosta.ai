---
import { COMPANY } from '../consts';

// The personal pages live here now that the tab words are gone.
const PERSONAL = [
	{ href: '/read', label: 'read' },
	{ href: '/look', label: 'look' },
	{ href: '/listen', label: 'listen' },
];
---

<footer>
	<nav aria-label="Personal">
		{PERSONAL.map((p) => <a class="word" href={p.href}>{p.label}</a>)}
	</nav>
	<small>© 2026 {COMPANY}</small>
</footer>

<style>
	footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.2em;
		padding: 5em 1em calc(3em + env(safe-area-inset-bottom, 0px));
		border-top: 1px solid var(--line);
		margin-top: 6em;
	}
	nav {
		display: flex;
		gap: 1.9em;
	}
	/* Padding widens the tap target; the negative margin keeps the spacing as it was. */
	a {
		padding: 0.75em 0.3em;
		margin: -0.75em -0.3em;
		font-size: 0.8125rem;
		color: var(--muted);
		transition: color var(--hover), text-shadow var(--hover);
	}
	a:hover {
		color: var(--head);
		text-shadow: var(--glow);
	}
	small {
		font-size: 0.6875rem;
		color: #7a7a7a;
		letter-spacing: 0.08em;
	}
</style>
