---
import { SITE_TITLE, TABS } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header transition:name="site-header">
	<a class="name word" href="/" transition:name="brand-name">{SITE_TITLE}</a>
	<nav transition:name="brand-tabs">
		{
			TABS.map((t) => (
				<a class:list={['word', { on: isActive(t.href) }]} href={t.href}>
					{t.label}
				</a>
			))
		}
	</nav>
	<button id="theme-toggle" type="button" aria-label="Toggle color theme">
		<span aria-hidden="true"></span>
	</button>
</header>

<style>
	header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.9em;
		padding: 2.2em 1em 1.8em;
		border-bottom: 1px solid var(--header-line);
		position: relative;
	}
	.name {
		font-size: 0.8125rem;
		color: var(--muted);
		transition: color var(--anim-dur) var(--anim-ease);
	}
	.name:hover {
		color: var(--fg);
	}
	nav {
		display: flex;
		gap: 1.9em;
	}
	nav a {
		font-size: 0.8125rem;
		color: var(--faint);
		transition: color var(--anim-dur) var(--anim-ease);
	}
	nav a:hover {
		color: var(--muted);
	}
	nav a.on {
		color: var(--fg);
	}
	#theme-toggle {
		position: absolute;
		top: 1.6em;
		right: 1.2em;
		width: 1.4em;
		height: 1.4em;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	#theme-toggle span {
		width: 0.7em;
		height: 0.7em;
		border-radius: 50%;
		border: 1px solid var(--muted);
		transition: background var(--anim-dur) var(--anim-ease), border-color var(--anim-dur) var(--anim-ease);
	}
	/* Filled dot in dark mode (tap for light), hollow in light mode. */
	:global(html[data-theme='dark']) #theme-toggle span {
		background: var(--muted);
	}
	#theme-toggle:hover span {
		border-color: var(--fg);
	}
	@media (max-width: 600px) {
		#theme-toggle {
			top: 1.2em;
			right: 1em;
		}
	}
</style>

<script>
	// Delegated so it keeps working across client-side (view transition) navigations.
	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		if (!target.closest('#theme-toggle')) return;
		const root = document.documentElement;
		const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
		root.setAttribute('data-theme', next);
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});
</script>
