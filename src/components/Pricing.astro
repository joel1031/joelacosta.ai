---
// Three ways in. Every button opens the same Cal.com calendar.
const PLANS = [
	{
		name: 'Discovery Call',
		sub: 'Always Free',
		points: ['Audit of your business', 'Expert advice', 'Live automation demos', 'Free system design, tools & roadmap'],
		action: 'Book a Discovery Call',
	},
	{
		name: 'Retainer',
		sub: 'Limited Spots Available',
		points: [
			'Multiple done-for-you systems per month',
			'Strategic partner across your business & goals',
			'Weekly strategy calls & delivery',
			'Monthly results guarantee',
		],
		action: 'Apply for a Spot Now',
		featured: true,
	},
	{
		name: 'Project Based',
		sub: 'On Request',
		points: [
			'One-off projects for businesses looking to start',
			'Clear deliverables & timeline',
			'No ongoing costs',
			'Project results guarantee',
		],
		action: 'Get a Quote',
		filled: true,
	},
];
---

<section class="sec" id="pricing">
	<h2 class="sec-title" data-lines><span data-line>Your Investment</span></h2>

	<div class="plans">
		{
			PLANS.map((p, i) => (
				<article class:list={['plan', { featured: p.featured, filled: p.filled }]} data-rise={String(i * 0.08)}>
					<div class="head">
						<h3>{p.name}</h3>
						<p class="sub">{p.sub}</p>
					</div>
					<ul>
						{p.points.map((point) => (
							<li>{point}</li>
						))}
					</ul>
					<div class="go">
						<button class="cta-book" type="button" data-book>
							{p.action}
						</button>
					</div>
				</article>
			))
		}
	</div>
</section>

<style>
	#pricing {
		scroll-margin-top: 56px;
	}
	.plans {
		max-width: 1100px;
		margin: 3.5em auto 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}
	/* Every card is framed and lifted; the last is filled grey; the middle wears the accent. */
	.plan {
		display: flex;
		flex-direction: column;
		padding: 2.4em clamp(1.4em, 2.4vw, 2.2em) 2.2em;
		border: 2px solid rgba(var(--ink), 0.11);
		border-radius: 24px;
		background: var(--bg);
		box-shadow: 0 2px 4px rgba(var(--ink), 0.04), 0 24px 48px -24px rgba(var(--ink), 0.2);
	}
	.filled {
		background: var(--panel);
		border-color: rgba(var(--ink), 0.07);
	}
	.featured {
		border-color: var(--accent);
		box-shadow: 0 2px 4px rgba(var(--ink), 0.04), 0 28px 56px -24px color-mix(in srgb, var(--accent) 35%, transparent);
	}
	/* Side by side, the cards share rows, so lists and buttons line up whatever each
	   heading runs to. The framed card stands a little taller than its neighbours. */
	@media (min-width: 861px) {
		.plans {
			grid-template-rows: repeat(3, auto);
			row-gap: 0;
		}
		.plan {
			display: grid;
			grid-row: span 3;
			grid-template-rows: subgrid;
			row-gap: 0;
		}
		.featured {
			margin-block: -14px;
			padding-block: calc(2.4em + 14px) calc(2.2em + 14px);
		}
	}
	.plan h3 {
		margin: 0;
		font-family: var(--font-unbounded), sans-serif;
		font-weight: 700;
		font-size: 1.15rem;
		line-height: 1.3;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--head);
	}
	.sub {
		margin: 0.5rem 0 0;
		color: var(--muted);
		font-style: italic;
		line-height: 1.5;
	}
	.plan ul {
		list-style: none;
		margin: 1.8rem 0 0;
		padding: 0;
		display: grid;
		align-content: start;
		gap: 0.8em;
		color: var(--text);
		line-height: 1.5;
	}
	.plan li {
		position: relative;
		padding-left: 2.1em;
	}
	/* The last point on each card is the one that matters. */
	.plan li:last-child {
		font-weight: 600;
		color: var(--head);
	}
	/* A filled dot with a check drawn in the page colour. */
	.plan li::before {
		content: '';
		position: absolute;
		left: 0;
		top: calc(0.75em - 10px);
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: var(--head);
	}
	.plan li::after {
		content: '';
		position: absolute;
		left: 7px;
		top: calc(0.75em - 7px);
		width: 4.5px;
		height: 9px;
		border: solid var(--bg);
		border-width: 0 2px 2px 0;
		transform: rotate(45deg);
	}
	.go {
		margin-top: 2.2em;
		display: flex;
		flex-direction: column;
		justify-content: end;
		flex-grow: 1;
	}
	.go .cta-book {
		align-self: start;
		padding: 1em 1.6em;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	@media (max-width: 860px) {
		.plans {
			grid-template-columns: 1fr;
			max-width: 520px;
			gap: 20px;
		}
	}
</style>
