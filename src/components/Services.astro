---
// The temple on the left, the three pillars on the right, in the hero's order. Each has
// one line on how it's served and a small mockup of one of its systems running.
import SystemVisual, { type SystemKind } from './SystemVisual.astro';

const SERVICES: { title: string; line: string; kind: SystemKind }[] = [
	{ title: 'GTM', line: 'Lead generation, CRM and nurture that bring customers in, on repeat.', kind: 'leads' },
	{
		title: 'Product Development',
		line: 'Websites, MVPs and internal tools, built to convert and built to last.',
		kind: 'web',
	},
	{
		title: 'Automation',
		line: 'Pipelines, follow-ups and AI agents that take the busywork off your team.',
		kind: 'pipeline',
	},
];
---

<section class="services" id="about">
	<h2 class="title">
		<span class="line" id="svc-line-1">We build the systems that</span>
		<span class="line" id="svc-line-2">allow your business to run itself.</span>
	</h2>

	<div class="split">
		<div class="temple" id="temple-box">
			<canvas id="temple" aria-hidden="true"></canvas>
		</div>

		<ul class="list">
			{
				SERVICES.map((s) => (
					<li class="svc">
						<h3>{s.title}</h3>
						<p>{s.line}</p>
						<SystemVisual kind={s.kind} />
					</li>
				))
			}
		</ul>
	</div>

	<div class="act">
		<button class="cta-book" type="button" data-calendly>Book a Discovery Call</button>
	</div>
</section>

<style>
	.services {
		scroll-margin-top: 56px;
		padding-block: 8vh 0;
		padding-inline: clamp(16px, 5vw, 64px);
	}
	.title {
		margin: 0 auto;
		max-width: 34ch;
		text-align: center;
		text-wrap: balance;
		color: var(--head);
		font-family: var(--font-unbounded), sans-serif;
		font-weight: 700;
		font-size: clamp(1.6rem, 3vw + 0.4rem, 2.6rem);
		line-height: 1.05;
		word-spacing: 0.12em;
		text-transform: uppercase;
	}
	.line {
		display: block;
	}
	.split {
		max-width: 1360px;
		margin: 5vh auto 0;
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: clamp(56px, 8vw, 150px);
		align-items: center;
	}
	.temple {
		width: 100%;
		aspect-ratio: 1;
	}
	.temple canvas {
		width: 100%;
		height: 100%;
		display: block;
	}
	.list {
		--hue: var(--accent);
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 20px;
	}
	/* One card per pillar: title, one line, then the mockup, all centred. */
	.svc {
		display: grid;
		justify-items: center;
		gap: 0.5em;
		padding: 26px 28px 28px;
		border: 1px solid var(--line);
		border-radius: 16px;
		background: var(--bg);
		text-align: center;
	}
	.svc h3 {
		margin: 0;
		font-family: var(--font-unbounded), sans-serif;
		font-weight: 700;
		font-size: 1.1rem;
		line-height: 1.3;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--head);
	}
	.svc p {
		margin: 0;
		max-width: 30em;
		color: var(--text);
		font-size: 1.05rem;
		line-height: 1.5;
	}
	.svc :global(.sys) {
		width: 100%;
		max-width: 420px;
		margin-top: 0.8em;
	}
	.act {
		margin-top: 3em;
		text-align: center;
	}
	.act .cta-book {
		padding: 0.85em 2.1em;
		font-size: 1.1rem;
	}

	/* Below 900px the two columns stack: the temple, then the three pillars. */
	@media (max-width: 900px) {
		.split {
			grid-template-columns: 1fr;
			max-width: 560px;
			gap: 3em;
		}
		.temple {
			aspect-ratio: 4 / 3;
		}
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { makeTemple } from '../scripts/temple';

	gsap.registerPlugin(ScrollTrigger);

	function init() {
		const box = document.querySelector<HTMLElement>('#temple-box');
		const canvas = document.querySelector<HTMLCanvasElement>('#temple');
		const section = document.querySelector<HTMLElement>('.services');
		if (!box || !canvas || !section) return;

		const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const temple = makeTemple(canvas, box, { still, ink: document.documentElement.dataset.theme === 'light' });
		const cleanups: (() => void)[] = [temple.destroy];

		if (!still) {
			// The heading arrives a line at a time, each blurring in from big to small. Once
			// in, it stays: `once` retires the trigger, so scrolling back up never replays it.
			const line = (el: string, start: string, end: string) => {
				const t = gsap.fromTo(
					el,
					{ opacity: 0, scale: 1.45, filter: 'blur(14px)' },
					{
						opacity: 1,
						scale: 1,
						filter: 'blur(0px)',
						ease: 'none',
						scrollTrigger: { trigger: section, start, end, scrub: true, once: true },
					},
				);
				cleanups.push(() => {
					t.scrollTrigger?.kill();
					t.kill();
				});
			};
			line('#svc-line-1', 'top 95%', 'top 55%');
			line('#svc-line-2', 'top 75%', 'top 35%');

			// The temple builds with scroll; each system appears as its column finishes.
			const items = [...section.querySelectorAll<HTMLElement>('.svc')];
			const reveal = (b: number) => {
				items.forEach((el, i) => {
					const k = Math.min(1, Math.max(0, (b - (0.36 + i * 0.12)) / 0.14));
					el.style.opacity = String(k);
					el.style.transform = `translateY(${(1 - k) * 16}px)`;
					el.style.filter = k < 1 ? `blur(${(1 - k) * 6}px)` : '';
				});
			};
			reveal(0);
			const at = (p: number) => {
				temple.setBuild(p);
				reveal(p);
			};
			const st = ScrollTrigger.create({
				trigger: box,
				start: 'top 90%',
				end: 'bottom 75%',
				once: true,
				onUpdate: (self) => at(self.progress),
				// Scrolling past the end quickly can skip the last update, which would leave
				// the roof off the temple. Built once, it stays built.
				onLeave: () => at(1),
			});
			cleanups.push(() => st.kill());

			// The mockups loop only while they are on screen.
			const io = new IntersectionObserver(
				(entries) => entries.forEach((e) => e.target.classList.toggle('live', e.isIntersecting)),
				{ threshold: 0.3 },
			);
			section.querySelectorAll('.sys').forEach((el) => io.observe(el));
			cleanups.push(() => io.disconnect());

			const cta = section.querySelector('.act');
			const act = gsap.fromTo(
				cta,
				{ opacity: 0, filter: 'blur(8px)' },
				{
					opacity: 1,
					filter: 'blur(0px)',
					duration: 0.6,
					ease: 'power2.out',
					scrollTrigger: { trigger: cta, start: 'top 98%', once: true },
				},
			);
			cleanups.push(() => {
				act.scrollTrigger?.kill();
				act.kill();
			});
		}

		document.addEventListener('astro:before-swap', () => cleanups.forEach((fn) => fn()), { once: true });
	}

	document.addEventListener('astro:page-load', init);
</script>
