---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';

// Replace with real links.
const contacts = [
	{ label: 'email', href: 'mailto:joela1031@gmail.com' },
	{ label: 'github', href: 'https://github.com/joel1031' },
];
---

<Layout title={`about · ${SITE_TITLE}`}>
	<main>
		<p class="bio">
			I'm Joel Acosta. <span class="todo">[short bio goes here]</span>
		</p>
		<ul class="contact">
			{
				contacts.map((c) => (
					<li>
						<a class="word" href={c.href}>
							{c.label}
						</a>
					</li>
				))
			}
		</ul>
	</main>
</Layout>

<style>
	main {
		width: 540px;
		max-width: calc(100% - 2.5em);
		margin: 0 auto;
		padding: 4em 0 6em;
	}
	.bio {
		font-size: 1.0625rem;
		line-height: 1.8;
		color: var(--fg);
		margin-bottom: 2.5em;
	}
	.todo {
		color: var(--faint);
	}
	.contact {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 1.8em;
	}
	.contact a {
		font-size: 0.8125rem;
		color: var(--muted);
		transition: color 0.2s ease;
	}
	.contact a:hover {
		color: var(--fg);
	}
</style>
