---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import Book from '../components/Book.astro';
import Footer from '../components/Footer.astro';

const description =
  'Joel Acosta AI LLC builds, automates and grows small businesses: product development, automation and go-to-market.';
---

<Layout description={description} bar="hero" theme="light" footer={false}>
	<Hero />
	<!-- The white page, as one sheet that slides up over the stuck hero. The footer rides
	     inside it, so nothing below the hero is ever see-through. -->
	<div class="sheet">
		<Services />
		<Process />
		<Pricing />
		<Faq />
		<Book />
		<Footer />
	</div>
</Layout>

<style>
	.sheet {
		position: relative;
		z-index: 1;
		background: var(--bg);
		border-radius: 28px 28px 0 0;
		/* Falls on the dark hero, so it's black whatever the theme. */
		box-shadow: 0 -24px 60px rgba(0, 0, 0, 0.35);
	}
	@media (max-width: 700px) {
		.sheet {
			border-radius: 20px 20px 0 0;
		}
	}
</style>

<script>
	import { reveal } from '../scripts/reveal';

	// Section headings and blocks below Services arrive as they scroll in.
	document.addEventListener('astro:page-load', () => {
		if (!document.querySelector('.hero')) return;
		const off = reveal();
		document.addEventListener('astro:before-swap', off, { once: true });
	});
</script>
