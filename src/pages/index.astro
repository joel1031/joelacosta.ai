---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';
---

<Layout nav={false}>
	<main>
		<h1 class="name">{SITE_TITLE}</h1>
		<nav>
			<a class="word" href="/read">read</a>
			<a class="word" href="/look">look</a>
			<a class="word" href="/lab">lab</a>
		</nav>
	</main>
</Layout>

<style>
	main {
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2.2em;
		padding: 1em;
	}
	.name {
		font-size: 1.5rem;
		font-weight: 400;
		letter-spacing: 0.14em;
		text-transform: lowercase;
		margin: 0;
		color: var(--fg);
	}
	nav {
		display: flex;
		gap: 2.1em;
	}
	nav a {
		font-size: 0.9375rem;
		color: var(--muted);
		transition: color var(--anim-dur) var(--anim-ease);
	}
	nav a:hover {
		color: var(--fg);
	}
	@media (max-width: 600px) {
		main {
			gap: 1.8em;
		}
		nav {
			gap: 1.6em;
		}
	}
</style>
