---
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';

const images = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/gallery/*.{jpg,jpeg,png,webp,avif}',
	{ eager: true },
);
const sources = Object.entries(images)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([, mod]) => mod.default);

// Full-size variant for the lightbox.
const gallery = await Promise.all(
	sources.map(async (src) => ({
		src,
		full: (await getImage({ src, width: 1800 })).src,
	})),
);

// Parallax travel per tile (%). Vary a little for depth.
const offsets = [12, 18, 15, 20, 14];
---

<Layout title="look · Joel Acosta">
	<main>
		<div class="masonry">
			{
				gallery.map((g, i) => (
					<button class="item" type="button" data-full={g.full} aria-label="Expand image">
						<div
							class="parallax"
							style={`aspect-ratio:${g.src.width} / ${g.src.height}; --parallax-offset:${offsets[i % offsets.length]}`}
						>
							<Image src={g.src} alt="" widths={[500, 1000]} sizes="(max-width: 560px) 92vw, 33vw" />
						</div>
					</button>
				))
			}
		</div>
	</main>

	<div id="lightbox" class="lightbox" hidden>
		<button class="close" type="button" aria-label="Close">×</button>
		<img id="lightbox-img" src="" alt="" />
	</div>
</Layout>

<style>
	main {
		width: var(--content-width);
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 2.5em 0 8em;
	}
	.masonry {
		--gap: 0.9rem;
		columns: 3;
		column-gap: var(--gap);
	}
	.item {
		display: block;
		width: 100%;
		break-inside: avoid;
		margin: 0 0 var(--gap);
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
	}

	/* CSS-native parallax: the box stays fixed (keeps spacing even),
	   the image translates inside an overflow-clipped container. */
	.parallax {
		view-timeline-name: --parallax-tl;
		view-timeline-axis: block;
		overflow: hidden;
		border-radius: 4px;
		width: 100%;
	}
	.parallax :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.92;
		transition: opacity 0.25s ease;
		scale: calc(1 + var(--parallax-offset, 16) * 2 / 100);
		animation: gallery-parallax auto linear both;
		animation-timeline: --parallax-tl;
		animation-range: cover;
		will-change: translate;
	}
	.item:hover .parallax :global(img) {
		opacity: 1;
	}

	@keyframes gallery-parallax {
		from {
			translate: 0 calc(var(--parallax-offset, 16) * -1%);
		}
		to {
			translate: 0 calc(var(--parallax-offset, 16) * 1%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.parallax :global(img) {
			animation: none;
			scale: 1;
		}
	}

	@media (max-width: 1024px) {
		.masonry {
			columns: 2;
		}
	}
	@media (max-width: 560px) {
		.masonry {
			columns: 1;
		}
	}

	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 4vh 4vw;
		background: rgba(0, 0, 0, 0.82);
		cursor: pointer;
	}
	.lightbox[hidden] {
		display: none;
	}
	.lightbox img {
		max-width: 100%;
		max-height: 92vh;
		width: auto;
		height: auto;
		border-radius: 4px;
		cursor: default;
	}
	.lightbox .close {
		position: absolute;
		top: 1rem;
		right: 1.2rem;
		font-size: 1.8rem;
		line-height: 1;
		color: var(--fg);
		background: none;
		border: none;
		cursor: pointer;
		opacity: 0.6;
	}
	.lightbox .close:hover {
		opacity: 1;
	}
</style>

<script>
	// Lightbox (parallax is now pure CSS).
	const box = document.getElementById('lightbox') as HTMLElement;
	const boxImg = document.getElementById('lightbox-img') as HTMLImageElement;
	const items = Array.from(document.querySelectorAll<HTMLElement>('.masonry .item'));
	const open = (full: string) => {
		boxImg.src = full;
		box.hidden = false;
		document.body.style.overflow = 'hidden';
	};
	const close = () => {
		box.hidden = true;
		boxImg.src = '';
		document.body.style.overflow = '';
	};
	for (const el of items) {
		el.addEventListener('click', () => {
			const full = el.dataset.full;
			if (full) open(full);
		});
	}
	box.addEventListener('click', (e) => {
		if (e.target !== boxImg) close();
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !box.hidden) close();
	});
</script>
