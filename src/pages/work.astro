---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PersonSchema from '../components/PersonSchema.astro';
import { CALENDLY_URL, FORMSPREE_ENDPOINT, SOCIALS } from '../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
	title="work · Joel Acosta"
	description="Joel Acosta is a full-stack engineer building B2B/D2C products and AI systems."
>
	<PersonSchema />
	<main>
		<header class="intro">
			<h1 class="word">Joel Acosta — Full-Stack Engineer</h1>
			<p class="bio">
				I'm a full-stack engineer with deep experience in building B2B/D2C products and AI systems. 👋🏽
			</p>
		</header>

		<section class="contact">
			<h2 class="word heading">contact</h2>
			<p class="lede">
				<a class="link" href={CALENDLY_URL} target="_blank" rel="noopener">book a call</a>, or send a
				note.
			</p>
			<form id="contact-form" action={FORMSPREE_ENDPOINT} method="POST">
				<label class="sr-only" for="cf-email">Your email</label>
				<input id="cf-email" type="email" name="email" placeholder="your email" required />
				<label class="sr-only" for="cf-message">Your message</label>
				<textarea id="cf-message" name="message" rows="4" placeholder="your message" required
				></textarea>
				{/* Formspree's honeypot: bots fill it, humans never see it. */}
				<input class="gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<div class="row">
					<button class="word" type="submit">send</button>
					<p class="status word" role="status" aria-live="polite"></p>
				</div>
			</form>
			<ul class="socials">
				{
					SOCIALS.map((s) => (
						<li>
							<a class="word link" href={s.href} target="_blank" rel="me noopener">
								{s.label}
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<h2 class="word heading">projects</h2>
		<ul class="projects">
			{
				projects.map((p) => (
					<li>
						<a href={`/work/${p.id}/`}>
							<Image
								class="thumb"
								width={640}
								height={360}
								widths={[640, 1280]}
								sizes="(max-width: 600px) calc(100vw - 2.5em), (max-width: 900px) 50vw, 33vw"
								src={p.data.thumbnail}
								alt=""
							/>
							<span class="t">{p.data.title}</span>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</Layout>

<script>
	// Delegated so it survives view-transition swaps. Submit events bubble, so one
	// listener on document covers the form however many times the DOM is replaced.
	// The form still has a real action/method — without JS it plainly POSTs to
	// Formspree and lands on their thank-you page.
	document.addEventListener('submit', async (e) => {
		const form = e.target;
		if (!(form instanceof HTMLFormElement) || form.id !== 'contact-form') return;
		e.preventDefault();

		const status = form.querySelector('.status') as HTMLElement | null;
		const button = form.querySelector('button') as HTMLButtonElement | null;
		if (!status || !button) return;

		button.disabled = true;
		status.textContent = 'sending…';

		try {
			const res = await fetch(form.action, {
				method: 'POST',
				body: new FormData(form),
				headers: { Accept: 'application/json' },
			});
			if (res.ok) {
				form.reset();
				status.textContent = 'Thanks — I’ll be in touch!';
				return;
			}
			throw new Error(String(res.status));
		} catch {
			status.textContent = 'didn’t send. try again, or reach me on linkedin.';
		}
		button.disabled = false;
	});
</script>

<style>
	main {
		width: var(--content-width);
		max-width: calc(100% - 2.5em);
		margin: 0 auto;
		padding: 2.5em 0 6em;
	}
	/* Prose sits in the narrower reading column even though the grid below
	   spans the full --content-width. */
	.intro {
		max-width: 680px;
		margin-bottom: 3.5em;
	}
	/* Lowercase is styling only — the markup keeps "Joel Acosta" in proper case. */
	h1 {
		font-size: 1.375rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		margin: 0 0 0.9em;
	}
	.bio {
		margin: 0;
		color: var(--muted);
	}
	.heading {
		font-size: 0.75rem;
		font-weight: 400;
		color: var(--faint);
		margin: 0 0 1.4em;
	}
	.contact {
		max-width: 680px;
		margin-bottom: 4em;
	}
	.lede {
		margin: 0 0 1.6em;
		color: var(--muted);
	}
	.link {
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-color: var(--faint);
		transition: text-decoration-color var(--anim-dur) var(--anim-ease), color var(--anim-dur) var(--anim-ease);
	}
	.link:hover {
		text-decoration-color: var(--fg);
	}
	form {
		display: flex;
		flex-direction: column;
		gap: 0.8em;
	}
	input[type='email'],
	textarea {
		width: 100%;
		padding: 0.7em 0.85em;
		font: inherit;
		font-size: 0.875rem;
		color: var(--fg);
		background: none;
		border: 1px solid var(--line);
		border-radius: 4px;
		transition: border-color var(--anim-dur) var(--anim-ease);
	}
	input[type='email']:focus,
	textarea:focus {
		outline: none;
		border-color: var(--muted);
	}
	input::placeholder,
	textarea::placeholder {
		color: var(--faint);
	}
	textarea {
		resize: vertical;
	}
	/* Honeypot — offscreen rather than display:none, which some bots detect. */
	.gotcha {
		position: absolute;
		left: -9999px;
		opacity: 0;
		pointer-events: none;
	}
	.row {
		display: flex;
		align-items: center;
		gap: 1.2em;
	}
	button {
		font: inherit;
		font-size: 0.8125rem;
		color: var(--muted);
		background: none;
		border: 1px solid var(--line);
		border-radius: 4px;
		padding: 0.55em 1.6em;
		cursor: pointer;
		transition: color var(--anim-dur) var(--anim-ease), border-color var(--anim-dur) var(--anim-ease);
	}
	button:hover:not(:disabled) {
		color: var(--fg);
		border-color: var(--muted);
	}
	button:disabled {
		opacity: 0.5;
		cursor: default;
	}
	.status {
		margin: 0;
		font-size: 0.75rem;
		color: var(--muted);
	}
	.socials {
		list-style: none;
		display: flex;
		gap: 1.6em;
		margin: 1.8em 0 0;
		padding: 0;
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.projects {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.6em;
	}
	.projects li a {
		display: block;
	}
	.thumb {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 4px;
		opacity: 0.9;
		transition: opacity var(--anim-dur) var(--anim-ease);
	}
	li a:hover .thumb {
		opacity: 1;
	}
	.t {
		display: block;
		margin-top: 0.7em;
		font-size: 0.8125rem;
		color: var(--muted);
		transition: color var(--anim-dur) var(--anim-ease);
	}
	li a:hover .t {
		color: var(--fg);
	}
	@media (max-width: 900px) {
		.projects {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 600px) {
		.projects {
			grid-template-columns: 1fr;
			gap: 1.8em;
		}
	}
</style>
